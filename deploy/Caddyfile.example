# Beispiel-Konfiguration für Caddy mit statischem Web-Container und Sidecar-Relay (MCP + Collab).
# Die statischen Assets werden von logiccircuit-web (Port 8080) ausgeliefert;
# alle Sidecar-Endpunkte (/mcp, /__mcp/*, /ws-mcp, /__collab/*, /ws-collab) laufen an logiccircuit-mcp:3001.

circuit.example.com {
	@sidecar path /mcp /__mcp/* /ws-mcp /__collab/* /ws-collab

	# GDPR: Optional Access-Logs für Sidecar-Pfade überspringen (ab Caddy 2.7+),
	# sofern für diese Site ein log-Block aktiv ist:
	# log_skip @sidecar

	handle @sidecar {
		reverse_proxy logiccircuit-mcp:3001 {
			# Ausreichende Timeouts für längere Simulationen und ruhige WebSockets
			transport http {
				read_timeout 10m
				write_timeout 10m
			}
		}
	}

	handle {
		reverse_proxy logiccircuit-web:8080
	}
}
