{
  "name": "logic-circuit-web",
  "description": "Logic Circuit Web - Interactive Digital Logic Circuit CAD and WebWorker Simulator in the Browser",
  "version": "1.1.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Andreas Friedel"
  },
  "homepage": "https://afe-gmdg.github.io/logic-circuit-web/",
  "repository": {
    "type": "git",
    "url": "https://github.com/AFE-GmdG/logic-circuit-web.git"
  },
  "bugs": {
    "url": "https://github.com/AFE-GmdG/logic-circuit-web/issues"
  },
  "keywords": [
    "logic-circuit",
    "digital-logic",
    "circuit-simulator",
    "schematics-editor",
    "electronics",
    "react",
    "typescript",
    "webworker",
    "mcp"
  ],
  "scripts": {
    "predev": "rimraf dist",
    "dev": "vite",
    "prebuild": "rimraf dist",
    "build": "vite build",
    "build:pages": "rimraf dist && vite build --mode pages",
    "preview": "vite preview",
    "errorcheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint",
    "lint-docs": "node scripts/lint-docs.mjs",
    "test": "vitest run",
    "clean": "rimraf dist",
    "rr": "rimraf dist node_modules yarn.lock"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "i18next": "27.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.3"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-import-x": "4.17.1",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
